+// Concept adapted from Chillerbot-UX: copy the nearest tee's appearance.
+// Re-uses BestClient::CopyPlayerSkin, which already handles player and dummy
+// skins/colors and sends the correct info packet.
+void CBestClient::UpdateCommunitySkinStealer()
+{
+    if(!g_Config.m_BcCommunityAutoSkinSteal || Client()->State() != IClient::STATE_ONLINE)
+        return;
+    if(!GameClient()->m_Snap.m_pLocalCharacter)
+        return;
+    const int64_t Now = time_get();
+    if(Now < m_CommunitySkinStealNextTime)
+        return;
+    const int LocalId = GameClient()->m_Snap.m_LocalClientId;
+    const auto *pChar = GameClient()->m_Snap.m_pLocalCharacter;
+    if(LocalId < 0 || LocalId >= MAX_CLIENTS)
+        return;
+    const vec2 OwnPos(pChar->m_X, pChar->m_Y);
+    int BestClientId = -1;
+    float BestDistance = (float)g_Config.m_BcCommunityAutoSkinStealRadius * 32.0f;
+    for(int Id = 0; Id < MAX_CLIENTS; ++Id)
+    {
+        if(Id == LocalId || !GameClient()->m_Snap.m_aCharacters[Id].m_Active)
+            continue;
+        const CGameClient::CClientData &Other = GameClient()->m_aClients[Id];
+        if(!Other.m_aSkinName[0])
+            continue;
+        const float Dist = distance(Other.m_RenderPos, OwnPos);
+        if(Dist < BestDistance)
+        {
+            BestDistance = Dist;
+            BestClientId = Id;
+        }
+    }
+    // Always throttle attempts to avoid repeated appearance updates.
+    m_CommunitySkinStealNextTime = Now + 10 * time_freq();
+    if(BestClientId < 0)
+        return;
+    const CGameClient::CClientData &Selected = GameClient()->m_aClients[BestClientId];
+    if(str_comp(Selected.m_aSkinName, g_Config.m_ClPlayerSkin) == 0 &&
+        Selected.m_UseCustomColor == g_Config.m_ClPlayerUseCustomColor &&
+        Selected.m_ColorBody == g_Config.m_ClPlayerColorBody &&
+        Selected.m_ColorFeet == g_Config.m_ClPlayerColorFeet)
+        return;
+    CopyPlayerSkin(BestClientId);
+}
